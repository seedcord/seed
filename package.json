{
    "name": "seed",
    "type": "module",
    "version": "0.1.0",
    "private": true,
    "engines": {
        "node": "^24.22.1 || >=26.12.1"
    },
    "scripts": {
        "dev": "seedcord dev",
        "build": "seedcord build",
        "deploy": "seedcord build && cf deploy --prebuilt",
        "codegen": "seedcord codegen",
        "types": "cf workers types",
        "commands": "seedcord commands",
        "emojis": "seedcord emojis",
        "ask": "seedcord ask",
        "commands:deploy": "seedcord commands deploy",
        "release": "NODE_ENV=production bun run commands:deploy && bun run deploy",
        "tc": "tsc --noEmit",
        "lint": "eslint \"src/**/*.{ts,tsx}\" --cache",
        "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix --cache",
        "fmt": "prettier --write \"src/**/*.{ts,tsx,css,json,md}\" --cache",
        "fmt:check": "prettier --check \"src/**/*.{ts,tsx,css,json,md}\" --cache",
        "check": "bun run tc && bun run lint && bun run fmt:check",
        "postinstall": "cf workers types"
    },
    "devDependencies": {
        "@cloudflare/vite-plugin": "2.0.0-rc.0",
        "@seedcord/eslint-config": "^3.0.2",
        "@seedcord/tsconfig": "3.0.1",
        "@tailwindcss/vite": "^4.3.5",
        "@types/node": "^26.6.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "cf": "1.0.0-rc.0",
        "discord-api-types": "^0.38.59",
        "eslint": "^10.13.0",
        "eslint-plugin-better-tailwindcss": "^4.11.0",
        "eslint-plugin-tailwind-canonical-classes": "^1.6.1",
        "jiti": "^2.7.0",
        "prettier": "^3.9.10",
        "seedcord": "0.25.0-next.1",
        "tailwindcss": "^4.3.5",
        "typescript": "~6.0",
        "vite": "^8.3.4"
    },
    "dependencies": {
        "@discordjs/builders": "^1.15.0",
        "@fontsource-variable/jetbrains-mono": "^5.3.0",
        "@fontsource-variable/space-grotesk": "^5.3.0",
        "@seedcord/brand": "./seedcord-brand-0.0.0.tgz",
        "@seedcord/docs-search": "./seedcord-docs-search-0.0.0.tgz",
        "@seedcord/http": "0.15.0-next.0",
        "@seedcord/plugin-linked-roles": "0.2.1-next.0",
        "@seedcord/ui": "./seedcord-ui-0.2.3.tgz",
        "db0": "^0.4.2",
        "envapt": "^9.2.0",
        "lucide-react": "^1.79.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "unstorage": "^2.0.0-beta.0"
    },
    "overrides": {
        "@seedcord/brand": "./seedcord-brand-0.0.0.tgz"
    }
}

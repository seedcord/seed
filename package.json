{
    "name": "seed",
    "type": "module",
    "version": "0.1.0",
    "private": true,
    "engines": {
        "node": "^24.22.1 || >=26.12.1"
    },
    "scripts": {
        "dev": "seedcord dev",
        "build": "seedcord build",
        "deploy": "seedcord build && cf deploy --prebuilt",
        "codegen": "seedcord codegen",
        "types": "cf workers types",
        "commands": "seedcord commands",
        "commands:deploy": "seedcord commands deploy",
        "tc": "tsc --noEmit",
        "lint": "eslint \"src/**/*.ts\" --cache",
        "lint:fix": "eslint \"src/**/*.ts\" --fix --cache",
        "fmt": "prettier --write \"src/**/*.{ts,json,md}\" --cache",
        "fmt:check": "prettier --check \"src/**/*.{ts,json,md}\" --cache",
        "check": "bun run tc && bun run lint && bun run fmt:check",
        "postinstall": "cf workers types"
    },
    "devDependencies": {
        "@cloudflare/vite-plugin": "2.0.0-beta.v.0",
        "@seedcord/eslint-config": "^3.0.0",
        "@seedcord/tsconfig": "^3.0.0",
        "@types/node": "^26.6.5",
        "cf": "1.0.0-beta.17",
        "eslint": "^10.13.0",
        "jiti": "^2.7.0",
        "prettier": "^3.9.10",
        "seedcord": "^0.22.0",
        "typescript": "~6.0",
        "vite": "^8.3.4"
    },
    "dependencies": {
        "@discordjs/builders": "^1.14.1",
        "@seedcord/http": "^0.11.0",
        "envapt": "^9.2.0"
    }
}
